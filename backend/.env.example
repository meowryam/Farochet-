# Server-only configuration. Copy to backend/.env. Never commit real values.
# Express API
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173

# Temporary local-only Product Management session. Supply a private random token;
# the application always assigns the RAAZIA role server-side. Do not configure in production.
DEV_RAAZIA_TOKEN=

# Supabase project (server-side values)
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Only if server-side Storage upload requires it; keep secret and never use a VITE_ prefix.
SUPABASE_SERVICE_ROLE_KEY=

# Supabase PostgreSQL Session Pooler connection string (port 5432), used by Prisma.
DATABASE_URL=
