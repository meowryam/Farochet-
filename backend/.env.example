# Server-only configuration. Copy to backend/.env. Never commit real values.
# Express API
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173

# Supabase project (server-side values)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Backend-only Supabase Auth Admin user creation (and optional server-side Storage); never use a VITE_ prefix.
SUPABASE_SERVICE_ROLE_KEY=

# Supabase PostgreSQL Session Pooler URLs (port 5432).
# Runtime role: farochet_runtime; used only by the Express/Prisma Repository.
DATABASE_URL=
# Migration role: farochet_migrator; used only by the Prisma CLI.
MIGRATION_DATABASE_URL=
