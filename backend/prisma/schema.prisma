generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  runtime                = "nodejs"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "ts"
}

datasource db {
  provider = "postgresql"
}

model Product {
  id          String    @id @default(uuid()) @db.Uuid
  name        String
  description String?
  category    String?
  images      String[]  @default([])
  basePrice   Int
  // The positive-price CHECK is enforced by the initial SQL migration.
  isArchived  Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  inquiries   Inquiry[]

  @@index([isArchived, createdAt])
}

model Inquiry {
  id         String   @id @default(uuid()) @db.Uuid
  // customerId is a plain UUID column until Member 2 merges the User model;
  // it becomes a relation to User at that point.
  customerId String   @db.Uuid
  productId  String?  @db.Uuid
  product    Product? @relation(fields: [productId], references: [id])
  message    String
  createdAt  DateTime @default(now())
  orders     Order[]
}

model Order {
  id                      String    @id @default(uuid()) @db.Uuid
  inquiryId               String    @db.Uuid
  inquiry                 Inquiry   @relation(fields: [inquiryId], references: [id])
  approvedPrice           Int
  negotiatedPriceSnapshot Int?
  manufacturingStatus     String    @default("Incomplete")
  paymentStatus           String?
  deliveryStatus          String?
  estimatedCompletionDate DateTime?
  confirmedAt             DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  @@index([inquiryId, confirmedAt])
  @@index([manufacturingStatus, confirmedAt])
}
