generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  runtime                = "nodejs"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "ts"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  RAAZIA
  CUSTOMER
}

enum CustomerRegistrationIntentStatus {
  PENDING
  ACTIVE
  CONSUMED
}

model User {
  id          String    @id @db.Uuid
  email       String    @unique
  displayName String
  role        UserRole  @default(CUSTOMER)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  inquiries   Inquiry[]
}

model CustomerRegistrationIntent {
  id             String                           @id @default(uuid()) @db.Uuid
  supabaseUserId String                           @unique @db.Uuid
  email          String                           @unique
  displayName    String
  status         CustomerRegistrationIntentStatus @default(PENDING)
  createdAt      DateTime                         @default(now())
  activatedAt    DateTime?
  expiresAt      DateTime?
  consumedAt     DateTime?

  @@index([email, status, createdAt])
  @@index([status, expiresAt])
}

model Product {
  id          String    @id @default(uuid()) @db.Uuid
  name        String
  description String?
  category    String?
  images      String[]  @default([])
  basePrice   Int
  // The positive-price CHECK is enforced by the initial SQL migration.
  isArchived  Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  inquiries   Inquiry[]

  @@index([isArchived, createdAt])
}

model PublicDiscount {
  id                  String   @id @default("current")
  active              Boolean  @default(false)
  fixedDiscountAmount Int?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model Inquiry {
  id             String          @id @default(uuid()) @db.Uuid
  customerId     String          @db.Uuid
  customer       User            @relation(fields: [customerId], references: [id], onDelete: Restrict)
  productId      String?         @db.Uuid
  product        Product?        @relation(fields: [productId], references: [id])
  message        String
  createdAt      DateTime        @default(now())
  orders         Order[]
  customizations Customization[]

  @@index([customerId, createdAt])
  @@index([productId])
}

model Customization {
  id                     String               @id @default(uuid()) @db.Uuid
  inquiryId              String               @db.Uuid
  inquiry                Inquiry              @relation(fields: [inquiryId], references: [id], onDelete: Restrict)
  productType            String
  size                   String?
  colour                 String?
  materials              String?
  quantity               Int
  budget                 String?
  specialInstructions    String?
  requiredCompletionDate DateTime?
  deliveryAddress        String?
  referenceImages        String[]             @default([])
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  pendingOrderRequest    PendingOrderRequest?

  @@index([inquiryId, createdAt])
}

model PendingOrderRequest {
  id              String        @id @default(uuid()) @db.Uuid
  customizationId String        @unique @db.Uuid
  customization   Customization @relation(fields: [customizationId], references: [id], onDelete: Restrict)
  status          String        @default("PENDING")
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([status, createdAt])
}

model Order {
  id                      String    @id @default(uuid()) @db.Uuid
  inquiryId               String    @db.Uuid
  inquiry                 Inquiry   @relation(fields: [inquiryId], references: [id])
  approvedPrice           Int
  negotiatedPriceSnapshot Int?
  manufacturingStatus     String    @default("Incomplete")
  paymentStatus           String?
  deliveryStatus          String?
  estimatedCompletionDate DateTime?
  confirmedAt             DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  @@index([inquiryId, confirmedAt])
  @@index([manufacturingStatus, confirmedAt])
}

model RaaziaAvailability {
  id          String   @id @default("current")
  information String
  updatedAt   DateTime @updatedAt
}
