{
  "name": "raazia-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Raazia Customer Inquiry, Quotation, and Custom Order Management System backend.",
  "scripts": {
    "dev": "node --experimental-strip-types --env-file=.env --watch src/server.js",
    "start": "node --experimental-strip-types --env-file=.env src/server.js",
    "test": "node --experimental-strip-types node_modules/vitest/vitest.mjs run",
    "test:watch": "node --experimental-strip-types node_modules/vitest/vitest.mjs",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "pg": "^8.16.3",
    "prisma": "^7.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "dotenv": "^18.0.10",
    "supertest": "^7.1.4",
    "vitest": "^5.1.1"
  }
}
